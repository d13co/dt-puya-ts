{
  "name": "@d13co/dt-algorand-typescript",
  "version": "1.3.1-dt.1.0.0",
  "description": "Fork of @algorandfoundation/algorand-typescript for dt-algorand, the time-travel fork of go-algorand: the types of Algorand TypeScript, compiled by dt-puya-ts",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d13co/dt-puya-ts.git",
    "directory": "packages/algo-ts"
  },
  "homepage": "https://github.com/d13co/dt-puya-ts/tree/dtalgorand/packages/algo-ts#readme",
  "bugs": {
    "url": "https://github.com/d13co/dt-puya-ts/issues"
  },
  "author": "Bit D13 <bit@d13.co>",
  "contributors": [
    "Algorand Foundation"
  ],
  "main": "index.js",
  "types": "src/index.ts",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "audit": "better-npm-audit audit",
    "format": "prettier --write .",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "build": "run-s build:*",
    "build:0-clean": "rimraf dist coverage",
    "build:1-lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "build:2-check-types": "tsc -p tsconfig.json",
    "build:3-build": "rollup -c --configPlugin typescript",
    "build:4-copy-pkg-json": "tsx scripts/copy-package-json.ts",
    "build:5-copy-readme": "shx cp ./readme.md ./dist",
    "watch": "rollup -c -w --configPlugin typescript",
    "test": "echo 'No tests'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node22": "22.0.5",
    "@types/node": "25.0.1",
    "@typescript-eslint/eslint-plugin": "8.49.0",
    "@typescript-eslint/parser": "8.49.0",
    "better-npm-audit": "3.11.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.2.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.7.4",
    "rimraf": "6.1.2",
    "rollup": "^4.59.0",
    "shx": "^0.4.0",
    "tsx": "4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "4.1.6"
  },
  "overrides": {},
  "peerDependencies": {
    "tslib": "^2.6.2"
  }
}
